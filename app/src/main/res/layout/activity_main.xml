<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="modelo" type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
        <variable name="controlador" type="es.davante.edadcanina.EdadCaninaControlador" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">


        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_edad"
            android:inputType="number"
            android:maxLength="2"
            android:gravity="center"
            android:text="@={modelo.entrada}"
            app:errorDinamico="@{modelo.validacion}"
            android:importantForAutofill="no" />

        <!-- NUEVO: android:onClick -->
        <Button
            android:id="@+id/btn_calc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="@{() -> controlador.calcular()}"
            android:text="Calcular" />


        <Button
            android:id="@+id/btn_limpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onClick="@{() -> controlador.limpiar()}"
            android:text="Limpiar" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@{modelo.resultado}"
            android:textSize="20sp" />

    </LinearLayout>
</layout>